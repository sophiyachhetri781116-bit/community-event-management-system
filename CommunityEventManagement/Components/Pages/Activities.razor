@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@page "/activities"
@rendermode InteractiveServer
@using CommunityEventManagement.Data.Models
@using CommunityEventManagement.Services
@inject ActivityService ActivityService
@inject NavigationManager Navigation

<PageTitle>Activities</PageTitle>

<!-- HEADER -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0" style="color:#2e1065;">Activities</h2>
        <p class="text-muted small mb-0">
            Activities available for community events
        </p>
    </div>

    <AuthorizeView Roles="Admin">
        <Authorized>
            <button class="btn btn-primary px-4" @onclick="Add">
                + Add Activity
            </button>
        </Authorized>
    </AuthorizeView>
</div>

<!-- STAT CARD -->
<div class="row mb-3">
    <div class="col-md-3">
        <div class="card text-center stat-card p-3">
            <div class="stat-number">@(activities?.Count ?? 0)</div>
            <div class="stat-label">Activities</div>
        </div>
    </div>
</div>

<!-- ACTIVITIES TABLE -->
<div class="card p-3">
    @if (activities is null)
    {
        <div class="text-center py-4">
            <div class="spinner-border" style="color:#5b2a9e;" role="status"></div>
        </div>
    }
    else if (activities.Count == 0)
    {
        <div class="empty-state py-4">
            <p class="fw-semibold">No activities found.</p>

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <p class="small text-muted">
                        Click <strong>+ Add Activity</strong> to create the first activity.
                    </p>
                </Authorized>
            </AuthorizeView>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var a in activities)
                    {
                        <tr>
                            <td class="fw-semibold">@a.Name</td>

                            <td>
                                <span class="badge bg-primary rounded-pill px-3">
                                    @a.Type
                                </span>
                            </td>

                            <td class="text-end">
                                <AuthorizeView Roles="Admin">
                                    <Authorized>
                                        <button class="btn btn-sm btn-outline-secondary me-1"
                                                @onclick="() => Edit(a.Id)">
                                            Edit
                                        </button>

                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => Delete(a.Id)">
                                            Delete
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Activity>? activities;

    protected override void OnInitialized() => Load();

    private void Load() => activities = ActivityService.GetList();

    private void Add() => Navigation.NavigateTo("/activities/add");

    private void Edit(int id) =>
        Navigation.NavigateTo($"/activities/edit/{id}");

    private void Delete(int id)
    {
        ActivityService.Delete(id);
        Load();
    }
}