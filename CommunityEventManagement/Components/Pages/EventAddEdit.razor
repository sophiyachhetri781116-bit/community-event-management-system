@page "/events/add"
@page "/events/edit/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using CommunityEventManagement.Data.Models
@using CommunityEventManagement.Services
@inject IEventService EventService
@inject VenueService VenueService
@inject ActivityService ActivityService
@inject NavigationManager Navigation

<PageTitle>@(Id == 0 ? "Add Event" : "Edit Event")</PageTitle>
<h3>@(Id == 0 ? "Add Event" : "Edit Event")</h3>

<EditForm Model="@eventItem" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Name</label>
        <InputText class="form-control" @bind-Value="eventItem.Name" />
    </div>
    <div class="mb-3">
        <label class="form-label">Date</label>
        <InputDate class="form-control" @bind-Value="eventItem.Date" />
    </div>
    <div class="mb-3">
        <label class="form-label">Time</label>
        <InputDate Type="InputDateType.Time" class="form-control" @bind-Value="eventItem.Time" />
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <InputTextArea class="form-control" @bind-Value="eventItem.Description" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Venues</label>
        @if (allVenues.Count == 0)
        {
            <p class="text-muted">No venues yet — add some on the Venues page.</p>
        }
        @foreach (var v in allVenues)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       checked="@selectedVenueIds.Contains(v.Id)"
                       @onchange="e => ToggleVenue(v.Id, e)" />
                <label class="form-check-label">@v.Name</label>
            </div>
        }
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Activities</label>
        @if (allActivities.Count == 0)
        {
            <p class="text-muted">No activities yet — add some on the Activities page.</p>
        }
        @foreach (var a in allActivities)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       checked="@selectedActivityIds.Contains(a.Id)"
                       @onchange="e => ToggleActivity(a.Id, e)" />
                <label class="form-check-label">@a.Name</label>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
</EditForm>

@code {
    [Parameter] public int Id { get; set; }
    private Event eventItem = new();

    private List<Venue> allVenues = new();
    private List<Activity> allActivities = new();
    private HashSet<int> selectedVenueIds = new();
    private HashSet<int> selectedActivityIds = new();

    protected override void OnParametersSet()
    {
        allVenues = VenueService.GetList();
        allActivities = ActivityService.GetList();

        if (Id != 0)
        {
            var existing = EventService.GetById(Id);
            if (existing != null)
            {
                eventItem = existing;
                selectedVenueIds = existing.Venues.Select(v => v.Id).ToHashSet();
                selectedActivityIds = existing.Activities.Select(a => a.Id).ToHashSet();
            }
        }
    }

    private void ToggleVenue(int id, ChangeEventArgs e)
    {
        if ((bool)e.Value!) selectedVenueIds.Add(id);
        else selectedVenueIds.Remove(id);
    }

    private void ToggleActivity(int id, ChangeEventArgs e)
    {
        if ((bool)e.Value!) selectedActivityIds.Add(id);
        else selectedActivityIds.Remove(id);
    }

    private void Save()
    {
        if (Id == 0)
            EventService.AddEvent(eventItem, selectedVenueIds.ToList(), selectedActivityIds.ToList());
        else
            EventService.UpdateEvent(eventItem, selectedVenueIds.ToList(), selectedActivityIds.ToList());

        Navigation.NavigateTo("/events");
    }

    private void Cancel() => Navigation.NavigateTo("/events");
}