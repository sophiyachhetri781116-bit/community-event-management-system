@page "/venues"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CommunityEventManagement.Data.Models
@using CommunityEventManagement.Services
@inject VenueService VenueService
@inject NavigationManager Navigation

<PageTitle>Venues</PageTitle>

<!-- HEADER -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0" style="color:#2e1065;">Venues</h2>
        <p class="text-muted small mb-0">Locations where community events are held</p>
    </div>
    <AuthorizeView Roles="Admin">
        <Authorized>
            <button class="btn btn-primary px-4" @onclick="Add">+ Add Venue</button>
        </Authorized>
    </AuthorizeView>
</div>

<!-- STAT CARD -->
<div class="row mb-3">
    <div class="col-md-4">
        <div class="card text-center stat-card p-3">
            <div class="stat-number">@(venues?.Count ?? 0)</div>
            <div class="stat-label">Registered Venues</div>
        </div>
    </div>
</div>

<!-- VENUES TABLE -->
<div class="card p-3">
    @if (venues is null)
    {
        <div class="text-center py-4">
            <div class="spinner-border" style="color:#5b2a9e;" role="status"></div>
        </div>
    }
    else if (venues.Count == 0)
    {
        <div class="empty-state py-4">
            <p class="fw-semibold">No venues found.</p>
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <p class="small text-muted">
                        Click <strong>+ Add Venue</strong> to create the first venue.
                    </p>
                </Authorized>
            </AuthorizeView>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Address</th>
                        <th>Capacity</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in venues)
                    {
                        <tr>
                            <td class="fw-semibold">@v.Name</td>
                            <td class="text-muted">@v.Address</td>
                            <td>
                                <span class="badge bg-primary rounded-pill px-3">
                                    @v.Capacity
                                </span>
                            </td>
                            <td class="text-end">
                                <AuthorizeView Roles="Admin">
                                    <Authorized>
                                        <button class="btn btn-sm btn-outline-secondary me-1"
                                                @onclick="() => Edit(v.Id)">
                                            Edit
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => Delete(v.Id)">
                                            Delete
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Venue>? venues;
    protected override void OnInitialized() => Load();
    private void Load() => venues = VenueService.GetList();
    private void Add() => Navigation.NavigateTo("/venues/add");
    private void Edit(int id) => Navigation.NavigateTo($"/venues/edit/{id}");
    private void Delete(int id) { VenueService.Delete(id); Load(); }
}
